# ===========================================================================
# english-bot configuration. Copy to `.env` and fill in real values.
# Docker Compose reads `.env` automatically (env_file).
# ===========================================================================

# --- Required ---------------------------------------------------------------
# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Your personal Telegram chat ID — receives "new user joined" notifications
# and gates admin commands (/metrics, /announce, /health).
MAINTAINER_CHAT_ID=

# --- AI providers (set AT LEAST ONE) ----------------------------------------
# The bot tries providers in AI_PROVIDER_ORDER and uses the first that has a
# key configured and responds. Any provider without a key is skipped.
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GITHUB_MODELS_TOKEN=
# Cloudflare Workers AI needs BOTH of these:
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
MISTRAL_API_KEY=

# --- Optional: provider order & per-provider model overrides ----------------
# AI_PROVIDER_ORDER=gemini,groq,cerebras,openrouter,github,cloudflare,mistral
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# CEREBRAS_MODEL=llama-3.3-70b
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# GITHUB_MODELS_MODEL=openai/gpt-4o-mini
# CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
# MISTRAL_MODEL=mistral-small-latest

# --- Optional: per-provider base URL overrides (rarely needed) --------------
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# --- Optional: scheduling & timezone ----------------------------------------
# TIMEZONE=Asia/Tehran
# QUIET_START=00:00
# QUIET_END=09:00

# --- Optional: content pool tuning ------------------------------------------
# POOL_TARGET=30
# POOL_MIN=10
# REFILL_INTERVAL=20s
# GEN_SPACING=3s

# --- Optional: spaced-repetition review tuning ------------------------------
# REVIEW_CHECK_INTERVAL=1h
# REVIEW_BATCH_MAX=3

# --- Optional: quiz tuning (set to 0 to disable scheduled quizzes) ----------
# QUIZ_INTERVAL=6h

# --- Optional: weekly digest tuning (set DIGEST_DAY=off to disable) ---------
# DIGEST_DAY=Sunday
# DIGEST_TIME=20:00
